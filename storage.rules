rules_version = '2';

// Hostela Storage rules — Phase 1 baseline.
// Phase 2 wires the app to these paths:
//   hostel-photos/{ownerUid}/{file}        — public listing photos
//   verification-docs/{ownerUid}/{file}    — CNIC / right-to-list documents, admin-only
// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && firestore.get(/databases/default/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }
    function isOwnerPath(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /hostel-photos/{uid}/{file} {
      allow read: if true;
      allow write: if isOwnerPath(uid) && isImage();
    }

    match /verification-docs/{uid}/{file} {
      allow read: if isOwnerPath(uid) || isAdmin();
      allow write: if isOwnerPath(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
