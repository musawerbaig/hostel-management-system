rules_version = '2';

// Hostela Firestore security rules — R2 (PRD §8 contract).
// Roles and statuses are the PRD's lowercase values; listings go
// 'pending' -> 'live' (never 'approved'). These rules are the real security
// boundary — the frontend checks are only UX.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && profile().role == 'admin';
    }
    function isOwner() {
      return isSignedIn() && profile().role == 'owner';
    }
    function isActive() {
      // Missing status on pre-R2 documents defaults to active (migration).
      return isSignedIn() && profile().get('status', 'active') == 'active';
    }

    // ---- User profiles (PRD §8.1) ----
    match /users/{uid} {
      // You can read your own profile; admins can read all.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // At sign-up you may create ONLY your own profile, as student or
      // owner, always starting 'active'. Role and status are not yours to
      // upgrade later (see update below).
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['student', 'owner']
        && request.resource.data.status == 'active'
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 2;
      // You may edit your own profile but never your own role or status.
      // Admins may change role/status (promotion, suspension).
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('status', 'active') == resource.data.get('status', 'active'));
      allow delete: if isAdmin();

      // R6 favourites: a user may only read/write their own saved listings.
      match /favourites/{listingId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---- Hostel listings (PRD §8.2) ----
    match /hostels/{hostelId} {
      // Public can browse live listings. Owners see their own at any
      // status; admins see everything (the verification queue).
      allow read: if resource.data.status == 'live'
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();
      // Owners (active) and admins submit, always as themselves, always
      // starting at 'pending' — verification cannot be skipped. Only
      // admins may create an already-verified listing (seed path).
      allow create: if isActive()
        && (isOwner() || isAdmin())
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 2
        && request.resource.data.pricePerBedMonthly is number
        && request.resource.data.pricePerBedMonthly >= 0
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 10
        && (isAdmin() || request.resource.data.get('verifiedAt', '') == '');
      // Owners may edit their own listing but cannot approve it, hand it
      // to someone else, or forge verification. They may keep the current
      // status or send it back to 'pending' (PRD re-verification trigger
      // for name/address changes); only admins set 'live', 'rejected',
      // 'paused' or 'suspended'. Owners may also pause a live listing
      // (and send a paused one back to 'pending'); only admins set 'live',
      // 'rejected' or 'suspended'. Admins can do anything (moderation).
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.get('verifiedAt', '') == resource.data.get('verifiedAt', '')
            && request.resource.data.get('verifiedBy', '') == resource.data.get('verifiedBy', '')
            && (request.resource.data.status == resource.data.status
                || request.resource.data.status == 'pending'
                || (request.resource.data.status == 'paused' && resource.data.status == 'live')));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ---- Verification documents (PRD §8.2, admin-only) ----
    // URLs for CNIC / right-to-list proofs. Never embedded in the public
    // listing document: a public read of a live listing must not leak them.
    match /verificationDocs/{listingId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create, update: if isActive()
        && (isAdmin()
            || (isSignedIn()
                && request.resource.data.ownerId == request.auth.uid
                && get(/databases/$(database)/documents/hostels/$(listingId)).data.ownerId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // ---- Listing contacts (R5, private) ----
    // One companion document per listing holding the owner's email. It is
    // NOT readable by the public: owners and admins always, plus any
    // student who has genuinely inquired about this listing (their uid is
    // added to allowedReaders by the rules-checked reveal in notifications.ts).
    match /listingContacts/{listingId} {
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.ownerId == request.auth.uid
            || request.auth.uid in resource.data.get('allowedReaders', [])));
      allow create: if isActive()
        && (isOwner() || isAdmin())
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.allowedReaders is list
        && request.resource.data.inquiryIds is list;
      // Owners may edit their own contact document. A student may ONLY
      // append their own uid and one inquiry id that the rules verify
      // belongs to them and to this listing's owner — the reveal step.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowedReaders', 'inquiryIds', 'lastInquiryId', 'updatedAt'])
            && request.resource.data.allowedReaders.size() == resource.data.allowedReaders.size() + 1
            && request.resource.data.allowedReaders.hasAll(resource.data.allowedReaders)
            && request.auth.uid in request.resource.data.allowedReaders
            && request.resource.data.inquiryIds.size() == resource.data.inquiryIds.size() + 1
            && request.resource.data.inquiryIds.hasAll(resource.data.inquiryIds)
            && request.resource.data.lastInquiryId in request.resource.data.inquiryIds
            && get(/databases/$(database)/documents/inquiries/$(request.resource.data.lastInquiryId)).data.studentId == request.auth.uid
            && get(/databases/$(database)/documents/inquiries/$(request.resource.data.lastInquiryId)).data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ---- Student inquiries (PRD §8.3) ----
    match /inquiries/{inquiryId} {
      // Visible only to the student who sent it, the hostel's owner, admins.
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.studentId == request.auth.uid
            || resource.data.ownerId == request.auth.uid));
      // A signed-in active user inquires for themselves, only about a live
      // listing, with a phone number (the owner's reply channel) and at
      // least one bed. Every inquiry starts life as 'new'.
      allow create: if isActive()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.studentPhone is string
        && request.resource.data.studentPhone.size() > 0
        && request.resource.data.bedsNeeded is number
        && request.resource.data.bedsNeeded >= 1
        && get(/databases/$(database)/documents/hostels/$(request.resource.data.hostelId)).data.status == 'live'
        && get(/databases/$(database)/documents/hostels/$(request.resource.data.hostelId)).data.ownerId == request.resource.data.ownerId;
      // Only the owner (or an admin) moves an inquiry through its lifecycle,
      // and may change nothing except the status.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status in ['contacted', 'stayed', 'closed']);
      allow delete: if isAdmin();
    }

    // ---- Reviews (PRD §8.4 — gated, one per confirmed stay) ----
    match /reviews/{reviewId} {
      // Reviews are public — they power the listing pages. (The UI shows
      // only status == 'visible'; reported/removed stay hidden.)
      allow read: if true;
      // The document id IS the inquiry id, so one review per inquiry.
      // Creation requires that inquiry to be marked 'stayed', to belong to
      // the caller, to be about the same hostel, and to start 'visible'.
      allow create: if isActive()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.inquiryId == reviewId
        && request.resource.data.status == 'visible'
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && get(/databases/$(database)/documents/inquiries/$(reviewId)).data.status == 'stayed'
        && get(/databases/$(database)/documents/inquiries/$(reviewId)).data.studentId == request.auth.uid
        && get(/databases/$(database)/documents/inquiries/$(reviewId)).data.hostelId == request.resource.data.hostelId;
      // Authors may edit the text/rating of their own review, never rebind
      // it or change its moderation status. Admins moderate (status).
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.studentId == request.auth.uid
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.hostelId == resource.data.hostelId
            && request.resource.data.inquiryId == resource.data.inquiryId
            && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.studentId == request.auth.uid);
    }

    // ---- Everything else is closed until its phase builds it ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
