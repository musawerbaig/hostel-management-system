rules_version = '2';

// Hostela Firestore security rules — Phase 1.
// Roles live in users/{uid} (written at sign-up by auth.ts).
// These rules are the real security boundary — the frontend checks are only UX.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && profile().role == 'Admin';
    }
    function isApprovedOwner() {
      return isSignedIn() && profile().role == 'Owner' && profile().isApproved == true;
    }

    // ---- User profiles ----
    match /users/{uid} {
      // You can read your own profile; admins can read all (owner approvals).
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // At sign-up you may create ONLY your own profile, and never as Admin.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['Student', 'Owner'];
      // You may edit your own profile but never your own role or approval.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.isApproved == resource.data.isApproved);
      allow delete: if isAdmin();
    }

    // ---- Hostel listings ----
    match /hostels/{hostelId} {
      // Public can browse approved listings. Owners see their own at any
      // status; admins see everything (the verification queue).
      allow read: if resource.data.status == 'approved'
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();
      // Only approved owners can submit, always as themselves, always
      // starting at 'pending' — verification cannot be skipped.
      allow create: if (isApprovedOwner() || isAdmin())
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Owners may edit their own listing, but cannot approve/reject it or
      // hand it to someone else. Admins can do anything (moderation).
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ---- Student inquiries (Phase 2) ----
    match /inquiries/{inquiryId} {
      // Visible only to the student who sent it, the hostel's owner, admins.
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.studentId == request.auth.uid
            || resource.data.ownerId == request.auth.uid));
      // A signed-in user inquires for themselves, only about an approved
      // listing, and every inquiry starts life as 'new'.
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'new'
        && get(/databases/$(database)/documents/hostels/$(request.resource.data.hostelId)).data.status == 'approved'
        && get(/databases/$(database)/documents/hostels/$(request.resource.data.hostelId)).data.ownerId == request.resource.data.ownerId;
      // Only the owner (or an admin) moves an inquiry through its lifecycle,
      // and may change nothing except the status.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['contacted', 'stayed', 'closed']);
      allow delete: if isAdmin();
    }

    // ---- Reviews (Phase 2 — gated, one per confirmed stay) ----
    match /reviews/{reviewId} {
      // Reviews are public — they power the listing pages.
      allow read: if true;
      // The document id IS the inquiry id, so one review per inquiry.
      // Creation requires that inquiry to be marked 'stayed', to belong to
      // the caller, and to be about the same hostel as the review.
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.inquiryId == reviewId
        && get(/databases/$(database)/documents/inquiries/$(reviewId)).data.status == 'stayed'
        && get(/databases/$(database)/documents/inquiries/$(reviewId)).data.studentId == request.auth.uid
        && get(/databases/$(database)/documents/inquiries/$(reviewId)).data.hostelId == request.resource.data.hostelId;
      // Authors may edit the text/rating of their own review, never rebind
      // it to another stay or hostel. Admins may moderate (delete).
      allow update: if isSignedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.hostelId == resource.data.hostelId
        && request.resource.data.inquiryId == resource.data.inquiryId;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.studentId == request.auth.uid);
    }

    // ---- Everything else is closed until its phase builds it ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
